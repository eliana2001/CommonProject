<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:EduPr.Data"
             x:Class="EduPr.EquipmentList">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 10">
      <TextBox x:Name="tbSearch" Width="300" Watermark="Поиск: название или номер" TextChanged="TbSearch_TextChanged"/>
      <Button Content="Добавить" Click="BtnAdd_Click"/> 
    </StackPanel>

    <DockPanel Grid.Row="1">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,*,*,*,*,170" Margin="12 0 12 5">
        <TextBlock Grid.Column="0" Text="Название" FontWeight="Bold"/>
        <TextBlock Grid.Column="1" Text="Инв. номер" FontWeight="Bold"/>
        <TextBlock Grid.Column="2" Text="Кабинет" FontWeight="Bold"/>
        <TextBlock Grid.Column="3" Text="Состояние" FontWeight="Bold"/>
        <TextBlock Grid.Column="4" Text="Следующее ТО" FontWeight="Bold"/>
      </Grid>

      <ListBox x:Name="lbEquipment">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="data:Equipment">
            <Grid ColumnDefinitions="2*,*,*,*,*,170">
              <TextBlock Grid.Column="0" Text="{Binding NameEquipment}"/>
              <TextBlock Grid.Column="1" Text="{Binding InventoryNumber}"/>
              <TextBlock Grid.Column="2" Text="{Binding Cabinet.NumberCabinet}"/> 
              <TextBlock Grid.Column="3" Text="{Binding StatusEquipment}"/>
              <TextBlock Grid.Column="4" Text="{Binding NextServiceDate}"/> 
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5">
                <Button Content="Правка" Click="BtnEdit_Click"/>
                <Button Content="Удалить" Click="BtnDelete_Click"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>