<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EduPr.SupplierControl">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Форма для ввода данных -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<StackPanel Margin="0,0,10,0">
				<TextBlock Text="Организация:"/>
				<TextBox x:Name="OrgNameTxt" Width="150"/>
			</StackPanel>
			<StackPanel Margin="0,0,10,0">
				<TextBlock Text="Контактное лицо:"/>
				<TextBox x:Name="ContactTxt" Width="150"/>
			</StackPanel>
			<StackPanel Margin="0,0,10,0">
				<TextBlock Text="Телефон:"/>
				<TextBox x:Name="PhoneTxt" Width="120"/>
			</StackPanel>
			<StackPanel Margin="0,0,10,0">
				<TextBlock Text="Адрес:"/>
				<TextBox x:Name="AddressTxt" Width="150"/>
			</StackPanel>
			<StackPanel Margin="0,0,10,0">
				<TextBlock Text="Email:"/>
				<TextBox x:Name="EmailTxt" Width="150"/>
			</StackPanel>
		</StackPanel>

		<!-- Таблица для отображения -->
		<DataGrid x:Name="SuppliersDataGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionChanged="SuppliersDataGrid_SelectionChanged" Margin="0,0,0,10"/>

		<!-- Кнопки управления -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button x:Name="AddBtn" Content="Добавить" Width="100" Margin="0,0,10,0" Click="AddBtn_Click"/>
			<Button x:Name="EditBtn" Content="Сохранить изменения" Width="130" Margin="0,0,10,0" Click="EditBtn_Click"/>
			<Button x:Name="DeleteBtn" Content="Удалить" Width="100" Margin="0,0,10,0" Click="DeleteBtn_Click"/>
			<Button x:Name="RefreshBtn" Content="Обновить" Width="100" Click="RefreshBtn_Click"/>
		</StackPanel>

		<!-- Сообщения об успехе или ошибке -->
		<TextBlock x:Name="StatusMessage" Grid.Row="3" Foreground="Red" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
	</Grid>
</UserControl>