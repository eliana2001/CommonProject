<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EduPr.HeadDepartments">
	<StackPanel Spacing="15" Margin="20">
		<Border Background="#ffffff" Padding="15" BorderBrush="#e0e0e0" BorderThickness="1">
			<Grid ColumnDefinitions="*,Auto">
				<TextBox x:Name="searchDepartmentTb" Watermark="Поиск по названию отдела" Padding="10" BorderBrush="#bbeaff" TextChanged="SearchTC"/>
				<Button Grid.Column="1" Content="Найти" Margin="10 0 0 0" Padding="20 10" Background="#fff3e0" Foreground="#e65100" BorderThickness="1" BorderBrush="#e65100" Click="SearchDepartment"/>
			</Grid>
		</Border>
		<Border Background="#ffffff" Padding="10" BorderBrush="#e0e0e0" BorderThickness="1">
			<DataGrid x:Name="DataItems" MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" DoubleTapped="TblDepartments_DoubleTapped">
				<DataGrid.Columns>
					<DataGridTextColumn Header="ID" Binding="{Binding IdDepartment}" Width="80"/>
					<DataGridTextColumn Header="Название отдела" Binding="{Binding NameDepartment}" Width="*"/>
					<DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
					<DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
					<DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
		<Button Content="Добавить отдел" HorizontalAlignment="Right" Padding="5 10" FontSize="14" FontWeight="Bold" Background="#e65100" Foreground="#fff3e0" BorderThickness="1" BorderBrush="#e65100" Click="AddDepartmentBtn_Click"/>
	</StackPanel>
</UserControl>